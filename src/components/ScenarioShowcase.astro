---
import { SCENARIOS } from "../lib/sim/scenarios";
---

<section aria-labelledby="scenarios-heading" class="scenario-showcase">
  <h2 id="scenarios-heading">Scenarios</h2>
  <p>
    The same brake tap plays out very differently depending on how closely people are following and
    how quickly they react. Pick a scenario to see it play out.
  </p>
  <div class="scenario-picker" role="group" aria-label="Choose a scenario">
    {
      SCENARIOS.map((scenario, index) => (
        <button
          type="button"
          class="scenario-button"
          data-scenario={scenario.id}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {scenario.label}
        </button>
      ))
    }
  </div>
  <canvas
    id="scenario-canvas"
    class="convoy-canvas"
    role="img"
    aria-label="A line of cars on a straight road, played out under the selected scenario's conditions"
    width="900"
    height="220"
  ></canvas>
  <button type="button" id="scenario-replay-button" class="speed-toggle-button">Replay this scenario</button>
  <dl class="scenario-narrative">
    <dt>What happens</dt>
    <dd id="scenario-what-happens"></dd>
    <dt>How it starts</dt>
    <dd id="scenario-how-it-starts"></dd>
    <dt>Why followers are affected</dt>
    <dd id="scenario-why-followers"></dd>
    <dt>How the wave develops</dt>
    <dd id="scenario-how-wave-develops"></dd>
    <dt>Why it outlasts its cause</dt>
    <dd id="scenario-why-outlasts"></dd>
  </dl>
</section>
