---

<section class="sim-visual" aria-label="Traffic simulation">
  <canvas
    id="road-canvas"
    class="road-canvas"
    role="img"
    aria-label="Circular road with 30 cars"
    width="600"
    height="600"
  ></canvas>
  <div class="sim-chart">
    <p class="chart-label">Average speed, last 10 seconds</p>
    <canvas
      id="chart-canvas"
      class="chart-canvas"
      role="img"
      aria-label="Average speed over the last 10 seconds"
      width="600"
      height="150"
    ></canvas>
  </div>
</section>
