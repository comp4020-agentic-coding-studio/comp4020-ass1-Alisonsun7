<section class="sim-metrics" aria-label="Live readouts">
  <dl class="metrics-grid">
    <div class="metric">
      <dt>Average speed</dt>
      <dd id="metric-avg-speed">— km/h</dd>
    </div>
    <div class="metric">
      <dt>Density</dt>
      <dd id="metric-density">— cars/km</dd>
    </div>
    <div class="metric">
      <dt>Wave strength</dt>
      <dd id="metric-wave-strength">—</dd>
    </div>
  </dl>

  <p class="sim-state" id="sim-state-region" aria-live="polite">
    <strong id="sim-state-label">Stable flow.</strong>
    <span id="sim-state-explanation">Every car is moving freely.</span>
  </p>
</section>
