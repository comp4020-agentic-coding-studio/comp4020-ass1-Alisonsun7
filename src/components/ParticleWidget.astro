---
type SliderKind =
  | "radius"
  | "chance"
  | "infectiousPeriod"
  | "betaGamma"
  | "travel"
  | "mask"
  | "vaccination";

const SLIDER_ORDER: SliderKind[] = [
  "radius",
  "chance",
  "infectiousPeriod",
  "betaGamma",
  "travel",
  "mask",
  "vaccination",
];

interface Props {
  id: string;
  mode: "simple" | "central" | "communities";
  showChart?: boolean;
  sliders?: SliderKind[];
  showQuarantineCheckbox?: boolean;
  showModeTabs?: boolean;
  badge?: string;
  ariaLabel?: string;
  radiusDefault?: number;
  chanceDefault?: number;
  periodDefault?: number;
  travelDefault?: number;
  maskDefault?: number;
  vaccinationDefault?: number;
  betaDefault?: number;
  gammaDefault?: number;
}

const {
  id,
  mode,
  showChart = true,
  sliders = [],
  showQuarantineCheckbox = false,
  showModeTabs = false,
  badge,
  ariaLabel = "Bouncing-particle epidemic simulation",
  radiusDefault = 8,
  chanceDefault = 6,
  periodDefault = 4,
  travelDefault = 0.1,
  maskDefault = 50,
  vaccinationDefault = 30,
  betaDefault = 0.35,
  gammaDefault = 0.15,
} = Astro.props;

const orderedSliders = SLIDER_ORDER.filter((kind) => sliders.includes(kind));
---

<div class="rec-widget" id={`${id}-widget`} data-initial-mode={mode}>
  {
    showModeTabs && (
      <div class="rec-tabs" role="tablist" aria-label="Simulation layout">
        <button
          class="rec-tab"
          type="button"
          data-rec-mode="simple"
          aria-pressed={mode === "simple" ? "true" : "false"}
        >
          Simple
        </button>
        <button
          class="rec-tab"
          type="button"
          data-rec-mode="central"
          aria-pressed={mode === "central" ? "true" : "false"}
        >
          Central location
        </button>
        <button
          class="rec-tab"
          type="button"
          data-rec-mode="communities"
          aria-pressed={mode === "communities" ? "true" : "false"}
        >
          Communities
        </button>
      </div>
    )
  }

  <p class="rec-case-label"></p>

  <div class="rec-canvas-wrap">
    <canvas class="rec-canvas" width="800" height="500" aria-label={ariaLabel}></canvas>
  </div>

  <div class="rec-pause-row">
    <div class="btn-row">
      <button class="btn rec-pause" type="button">Pause</button>
      <button class="btn rec-reset" type="button">Reset</button>
    </div>
    {
      showQuarantineCheckbox && (
        <label class="rec-quarantine" for={`${id}-quarantine`}>
          <input type="checkbox" id={`${id}-quarantine`} class="rec-quarantine-input" />
          Quarantine confirmed cases
        </label>
      )
    }
    {badge && <p class="rec-badge">{badge}</p>}
  </div>

  {
    showChart && (
      <div class="rec-chart-row">
        <svg
          class="growth-chart rec-chart"
          viewBox="0 0 400 190"
          preserveAspectRatio="xMidYMid meet"
          role="img"
          aria-label="Share of the population susceptible, infected, and recovered over time"
        >
          <line class="rec-grid" x1="50" y1="10" x2="390" y2="10" />
          <line class="rec-grid" x1="50" y1="40" x2="390" y2="40" />
          <line class="rec-grid" x1="50" y1="70" x2="390" y2="70" />
          <line class="rec-grid" x1="50" y1="100" x2="390" y2="100" />
          <line class="rec-grid" x1="50" y1="130" x2="390" y2="130" />
          <line class="rec-axis" x1="50" y1="160" x2="390" y2="160" />
          <line class="rec-vgrid" x1="50" y1="10" x2="50" y2="160" />
          <line class="rec-vgrid" x1="135" y1="10" x2="135" y2="160" />
          <line class="rec-vgrid" x1="220" y1="10" x2="220" y2="160" />
          <line class="rec-vgrid" x1="305" y1="10" x2="305" y2="160" />
          <line class="rec-vgrid" x1="390" y1="10" x2="390" y2="160" />
          <text class="rec-axis-label" x="44" y="13" text-anchor="end">
            100
          </text>
          <text class="rec-axis-label" x="44" y="43" text-anchor="end">
            80
          </text>
          <text class="rec-axis-label" x="44" y="73" text-anchor="end">
            60
          </text>
          <text class="rec-axis-label" x="44" y="103" text-anchor="end">
            40
          </text>
          <text class="rec-axis-label" x="44" y="133" text-anchor="end">
            20
          </text>
          <text class="rec-axis-label" x="44" y="163" text-anchor="end">
            0
          </text>
          <text class="rec-axis-label rec-xtick" x="50" y="178" text-anchor="start">
            Day 0
          </text>
          <text class="rec-axis-label rec-xtick" x="135" y="178" text-anchor="middle">
            Day 0
          </text>
          <text class="rec-axis-label rec-xtick" x="220" y="178" text-anchor="middle">
            Day 0
          </text>
          <text class="rec-axis-label rec-xtick" x="305" y="178" text-anchor="middle">
            Day 0
          </text>
          <text class="rec-axis-label rec-xtick" x="390" y="178" text-anchor="end">
            Day 0
          </text>
          <polygon class="rec-band-s" points="50,160 390,160 390,160 50,160" />
          <polygon class="rec-band-i" points="50,160 390,160 390,160 50,160" />
          <polygon class="rec-band-r" points="50,160 390,160 390,160 50,160" />
        </svg>
        <div class="rec-legend-col">
          <p class="rec-day">Day 0</p>
          <ul class="rec-legend">
            <li class="rec-legend-s"><span class="swatch rec-swatch-s" /><span class="rec-pct-s">99.3</span>% susceptible</li>
            <li class="rec-legend-i"><span class="swatch rec-swatch-i" /><span class="rec-pct-i">0.7</span>% infected</li>
            <li class="rec-legend-r"><span class="swatch rec-swatch-r" /><span class="rec-pct-r">0.0</span>% recovered</li>
          </ul>
        </div>
      </div>
    )
  }

  {
    orderedSliders.map((kind) => {
      if (kind === "radius") {
        return (
          <div class="rec-slider">
            <label for={`${id}-radius`}>
              Infection radius{" "}
              <output class="rec-radius-output" for={`${id}-radius`}>
                {radiusDefault}
              </output>
              px
            </label>
            <input
              class="rec-range rec-radius-input"
              type="range"
              id={`${id}-radius`}
              min="4"
              max="20"
              step="1"
              value={radiusDefault}
            />
          </div>
        );
      }
      if (kind === "chance") {
        return (
          <div class="rec-slider">
            <label for={`${id}-chance`}>
              Chance of infection per contact{" "}
              <output class="rec-chance-output" for={`${id}-chance`}>
                {chanceDefault}
              </output>
              %
            </label>
            <input
              class="rec-range rec-chance-input"
              type="range"
              id={`${id}-chance`}
              min="1"
              max="30"
              step="1"
              value={chanceDefault}
            />
          </div>
        );
      }
      if (kind === "infectiousPeriod") {
        return (
          <div class="rec-slider">
            <label for={`${id}-period`}>
              Infectious period{" "}
              <output class="rec-period-output" for={`${id}-period`}>
                {periodDefault}
              </output>{" "}
              days
            </label>
            <input
              class="rec-range rec-period-input"
              type="range"
              id={`${id}-period`}
              min="2"
              max="20"
              step="1"
              value={periodDefault}
            />
          </div>
        );
      }
      if (kind === "betaGamma") {
        return (
          <div class="rec-slider rec-beta-gamma">
            <label for={`${id}-beta`}>β — transmission rate</label>
            <input
              class="rec-range rec-beta-input"
              type="range"
              id={`${id}-beta`}
              min="0.05"
              max="0.6"
              step="0.01"
              value={betaDefault}
            />
            <label for={`${id}-gamma`}>γ — recovery rate</label>
            <input
              class="rec-range rec-gamma-input"
              type="range"
              id={`${id}-gamma`}
              min="0.03"
              max="0.5"
              step="0.01"
              value={gammaDefault}
            />
            <p class="r0-formula">
              R0 = β / γ ={" "}
              <output class="rec-beta-output" for={`${id}-beta`}>
                {betaDefault.toFixed(2)}
              </output>{" "}
              /{" "}
              <output class="rec-gamma-output" for={`${id}-gamma`}>
                {gammaDefault.toFixed(2)}
              </output>{" "}
              ={" "}
              <output class="rec-r0-value" for={`${id}-beta ${id}-gamma`}>
                {(betaDefault / gammaDefault).toFixed(2)}
              </output>
            </p>
          </div>
        );
      }
      if (kind === "travel") {
        return (
          <div class="rec-slider">
            <label for={`${id}-travel`}>
              Travel between communities{" "}
              <output class="rec-travel-output" for={`${id}-travel`}>
                {travelDefault}
              </output>
              %
            </label>
            <input
              class="rec-range rec-travel-input"
              type="range"
              id={`${id}-travel`}
              min="0"
              max="5"
              step="0.1"
              value={travelDefault}
            />
          </div>
        );
      }
      if (kind === "mask") {
        return (
          <div class="rec-slider">
            <label for={`${id}-mask`}>
              Wearing masks{" "}
              <output class="rec-mask-output" for={`${id}-mask`}>
                {maskDefault}
              </output>
              %
            </label>
            <input
              class="rec-range rec-mask-input"
              type="range"
              id={`${id}-mask`}
              min="0"
              max="100"
              step="5"
              value={maskDefault}
            />
            <p class="rec-mask-callout">
              Unmasked: about <output class="rec-mask-callout-unmasked">–</output>% chance per
              contact · masked: about <output class="rec-mask-callout-masked">–</output>%
            </p>
          </div>
        );
      }
      return (
        <div class="rec-slider">
          <label for={`${id}-vaccination`}>
            Vaccinated at the start{" "}
            <output class="rec-vaccination-output" for={`${id}-vaccination`}>
              {vaccinationDefault}
            </output>
            %
          </label>
          <input
            class="rec-range rec-vaccination-input"
            type="range"
            id={`${id}-vaccination`}
            min="0"
            max="100"
            step="5"
            value={vaccinationDefault}
          />
        </div>
      );
    })
  }
</div>

<style>
  .rec-widget {
    margin-block: var(--space-3);
  }

  .rec-case-label {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .rec-canvas-wrap {
    display: flex;
    justify-content: center;
    margin-block-end: var(--space-3);
  }

  .rec-canvas {
    width: 100%;
    max-width: 34rem;
    height: auto;
    background: #000;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .rec-pause-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-3);
  }

  .rec-quarantine {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    cursor: pointer;
  }

  .rec-badge {
    margin: 0;
    padding: 0.3rem 0.85rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
  }

  .rec-tabs {
    display: flex;
    overflow: hidden;
    margin-block-end: var(--space-3);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .rec-tab {
    flex: 1;
    overflow: hidden;
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    color: var(--muted);
    border: none;
    font: inherit;
    font-weight: 700;
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    cursor: pointer;
  }

  .rec-tab[aria-pressed="true"] {
    background: var(--accent);
    color: var(--accent-fg);
  }

  .rec-chart-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-block-end: var(--space-3);
  }

  .rec-chart {
    flex: 1 1 20rem;
    min-width: 0;
    max-width: 30rem;
    height: auto;
    margin-inline: 0;
  }

  .rec-grid {
    stroke: var(--border);
    stroke-width: 1;
  }

  .rec-vgrid {
    stroke: var(--border);
    stroke-width: 1;
    opacity: 0.5;
  }

  .rec-axis {
    stroke: var(--muted);
    stroke-width: 1;
  }

  .rec-axis-label {
    fill: var(--muted);
    font-size: 12px;
  }

  .rec-legend-col {
    display: flex;
    flex: 1 1 10rem;
    flex-direction: column;
    gap: var(--space-2);
  }

  .rec-day {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .rec-legend {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
  }

  .rec-legend li {
    display: flex;
    align-items: center;
  }

  .rec-swatch-s {
    background: #38bdf8;
  }

  .rec-swatch-i {
    background: #fb7159;
  }

  .rec-swatch-r {
    background: #94a3b8;
  }

  .rec-band-s {
    fill: #38bdf8;
  }

  .rec-band-i {
    fill: #fb7159;
  }

  .rec-band-r {
    fill: #94a3b8;
  }

  .rec-slider {
    margin-block-end: var(--space-3);
  }

  .rec-slider label {
    display: block;
    margin-block-end: var(--space-2);
    font-weight: 600;
  }

  .rec-slider output {
    font-weight: 400;
    color: var(--muted);
  }

  .rec-beta-gamma label:not(:first-child) {
    margin-block-start: var(--space-3);
  }

  .r0-formula {
    margin: var(--space-2) 0 0;
    padding: var(--space-2) var(--space-3);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-weight: 600;
  }

  .r0-formula .rec-r0-value {
    color: var(--accent);
    font-weight: 800;
  }

  .rec-mask-callout {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .rec-range {
    width: 100%;
    height: 2px;
    background: var(--border);
    appearance: none;
    outline: none;
  }

  .rec-range::-webkit-slider-thumb {
    width: 16px;
    height: 16px;
    background: var(--accent);
    border-radius: 50%;
    appearance: none;
    cursor: pointer;
  }

  .rec-range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    background: var(--accent);
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }

  .rec-range::-moz-range-track {
    height: 2px;
    background: var(--border);
  }

  @media (width <= 640px) {
    .rec-tab {
      padding-inline: var(--space-2);
      font-size: 0.62rem;
      letter-spacing: 0.01em;
    }
  }
</style>
