---
---

<section class="sim-controls" aria-label="Simulation controls">
  <fieldset class="presets">
    <legend>Scenarios</legend>
    <button type="button" class="preset-button" data-preset="sunday-morning">Sunday morning</button>
    <button type="button" class="preset-button" data-preset="peak-hour">Peak hour</button>
    <button type="button" class="preset-button" data-preset="school-pickup">School pickup</button>
  </fieldset>

  <div class="slider-group">
    <label for="car-count-input">Number of cars</label>
    <input type="range" id="car-count-input" min="15" max="60" step="1" value="30" />
    <output id="car-count-output" for="car-count-input">30 cars</output>
  </div>

  <div class="slider-group">
    <label for="reaction-time-input">Driver reaction time</label>
    <input type="range" id="reaction-time-input" min="0.1" max="2" step="0.1" value="0.8" />
    <output id="reaction-time-output" for="reaction-time-input">0.8 s</output>
  </div>

  <div class="slider-group">
    <label for="following-distance-input">Safe following distance</label>
    <input type="range" id="following-distance-input" min="5" max="30" step="1" value="15" />
    <output id="following-distance-output" for="following-distance-input">15 m</output>
  </div>

  <button type="button" id="brake-tap-button" class="brake-tap-button">Tap the brakes</button>
</section>
