---
---

<section class="sim-controls" aria-label="Simulation controls">
  <div class="slider-group">
    <label for="car-count-input">Number of cars</label>
    <input
      type="range"
      id="car-count-input"
      min="10"
      max="30"
      step="1"
      value="20"
      aria-valuetext="20 cars"
    />
    <output id="car-count-output" for="car-count-input">20 cars</output>
  </div>

  <div class="slider-group">
    <label for="reaction-time-input">Driver reaction time</label>
    <input
      type="range"
      id="reaction-time-input"
      min="0.1"
      max="2"
      step="0.1"
      value="0.8"
      aria-valuetext="0.8 seconds"
    />
    <output id="reaction-time-output" for="reaction-time-input">0.8 s</output>
  </div>

  <div class="slider-group">
    <label for="following-distance-input">Safe following distance</label>
    <input
      type="range"
      id="following-distance-input"
      min="5"
      max="30"
      step="1"
      value="15"
      aria-valuetext="15 metres"
    />
    <output id="following-distance-output" for="following-distance-input">15 m</output>
  </div>

  <button
    type="button"
    id="brake-tap-button"
    class="brake-tap-button"
    aria-label="Tap the brakes (free experiment)"
  >
    Tap the brakes
  </button>
  <button
    type="button"
    id="speed-toggle-button"
    class="speed-toggle-button"
    aria-label="Simulation speed, currently 1×"
  >
    Speed: 1×
  </button>
</section>
