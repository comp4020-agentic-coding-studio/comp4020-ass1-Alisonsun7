---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  accent?: "blue" | "violet" | "green" | "amber" | "rose";
}

const { title, description, accent = "blue" } = Astro.props;
const base = import.meta.env.BASE_URL;

const sections = [
  { href: "#simple-case", label: "Simple case" },
  { href: "#measuring", label: "Measuring" },
  { href: "#parameters", label: "Parameters" },
  { href: "#isolation", label: "Isolation" },
  { href: "#hotspot", label: "Hotspot" },
  { href: "#communities", label: "Communities" },
  { href: "#real-diseases", label: "Real diseases" },
  { href: "#sandbox", label: "Sandbox" },
  { href: "#takeaways", label: "Takeaways" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body data-accent={accent}>
    <header class="site-header">
      <nav aria-label="Primary">
        <a class="brand" href={base}>What stops an outbreak</a>
        <ul>
          {
            sections.map((section) => (
              <li>
                <a href={section.href}>{section.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>COMP4020/8020 Assignment 1 — one interactive deep-dive into epidemic modelling.</p>
    </footer>
  </body>
</html>
