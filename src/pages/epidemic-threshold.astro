---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="The epidemic threshold — a particle simulation"
  description="Watch a bouncing-particle outbreak flip from fizzling out to sweeping through, around a threshold contact rate."
  accent="amber"
  activePath={`${base}epidemic-threshold/`}
>
  <h1>Why one extra contact can flip fizzle into outbreak</h1>
  <p class="lede">
    180 people, bouncing around at random and brushing past each other. One
    starts infected. The only thing the slider changes is how many people
    each infected person passes it to on average before they recover. Watch
    how little that number has to move before the outcome flips completely.
  </p>

  <section class="panel" aria-label="Simulation">
    <p class="preset-caption">Layout:</p>
    <div class="btn-row" role="group" aria-label="Simulation layout">
      <button class="btn" type="button" data-mode="simple" aria-pressed="true">Simple</button>
      <button class="btn" type="button" data-mode="central" aria-pressed="false">Central location</button>
      <button class="btn" type="button" data-mode="communities" aria-pressed="false">Communities</button>
    </div>
    <p class="preset-note">
      <strong>Simple:</strong> everyone wanders freely. <strong>Central
        location:</strong> everyone occasionally visits and lingers at one shared
      spot, like a market or well. <strong>Communities:</strong> four separate
      groups, with rare travel between them.
    </p>

    <div class="controls">
      <div class="control">
        <label for="contact-slider"
          >Contact rate (≈ R₀) <output id="contact-output" for="contact-slider">1.0</output
          ></label
        >
        <input type="range" id="contact-slider" min="0.5" max="4" step="0.1" value="1.0" />
      </div>
    </div>

    <p class="preset-caption">Try a real disease's ballpark R₀:</p>
    <div class="btn-row">
      <button class="btn" type="button" data-rate="1.3">Seasonal flu ≈1.3</button>
      <button class="btn" type="button" data-rate="2.5">COVID-19, original strain ≈2.5</button>
    </div>
    <p class="preset-note">
      Commonly cited ballpark estimates, simplified for illustration. Measles
      sits far higher still, around R₀ 12–18 — off this slider's range
      entirely.
    </p>

    <p class="preset-caption">Try an intervention, same disease:</p>
    <div class="btn-row">
      <button class="btn" type="button" data-rate="3.0">No precautions</button>
      <button class="btn" type="button" data-rate="1.8">Masks</button>
      <button class="btn" type="button" data-rate="1.0">Vaccination</button>
      <button class="btn" type="button" data-rate="0.6">Masks + distancing</button>
    </div>

    <p class="assumption">
      180 people bouncing at a fixed speed inside the box below, one starts
      infectious, each stays infectious for the same number of frames before
      recovering. Patient zero and every coin flip behind a run are fixed by
      a seed — only the sliders, checkbox, and layout buttons change
      anything: how many people each infectious person passes it to, how
      tightly packed everyone is, how long a case incubates silently before
      it can be caught, and whether confirmed cases are removed from
      circulation.
    </p>

    <div class="controls">
      <div class="control">
        <label for="density-slider"
          >Population density <output id="density-output" for="density-slider"
            >Typical spacing</output
          ></label
        >
        <input type="range" id="density-slider" min="60" max="160" step="10" value="100" />
      </div>
      <div class="control">
        <label for="incubation-slider"
          >Incubation period <output id="incubation-output" for="incubation-slider"
            >None (plain S-I-R)</output
          ></label
        >
        <input type="range" id="incubation-slider" min="0" max="240" step="20" value="0" />
      </div>
    </div>

    <p class="quarantine-row">
      <label>
        <input type="checkbox" id="quarantine-checkbox" />
        Quarantine confirmed cases (freezes infectious particles in place —
        does not catch anyone still incubating)
      </label>
    </p>

    <div class="btn-row sim-controls">
      <button class="btn" type="button" id="pause-btn">Pause</button>
      <button class="btn" type="button" id="reset-btn">Reset</button>
    </div>

    <canvas id="sim-canvas" class="sim-canvas" width="800" height="500" role="img" aria-label="Particles bouncing in a box, coloured by infection status"
    ></canvas>
    <p class="network-legend">
      <span class="swatch swatch-s"></span>Susceptible &nbsp;&nbsp;<span
        class="swatch swatch-e"
      ></span>Incubating &nbsp;&nbsp;<span class="swatch swatch-i"
      ></span>Infectious &nbsp;&nbsp;<span class="swatch swatch-r"></span>Recovered
    </p>

    <div class="stat-row">
      <div class="stat">
        <span class="value" id="stat-s">100.0%</span>
        <span class="label">Susceptible</span>
      </div>
      <div class="stat">
        <span class="value" id="stat-e">0.0%</span>
        <span class="label">Incubating</span>
      </div>
      <div class="stat">
        <span class="value" id="stat-i">0.0%</span>
        <span class="label">Infectious</span>
      </div>
      <div class="stat">
        <span class="value" id="stat-r">0.0%</span>
        <span class="label">Recovered</span>
      </div>
    </div>

    <svg class="growth-chart" viewBox="0 0 600 200" role="img" aria-labelledby="et-chart-title">
      <title id="et-chart-title">Share of the population in each state, over time</title>
      <polygon id="chart-area-s" class="area-s" points="" />
      <polygon id="chart-area-e" class="area-e" points="" />
      <polygon id="chart-area-i" class="area-i" points="" />
      <polygon id="chart-area-r" class="area-r" points="" />
    </svg>
    <p class="chart-legend">
      <span class="swatch swatch-s"></span>Susceptible &nbsp;&nbsp;<span
        class="swatch swatch-e"
      ></span>Incubating &nbsp;&nbsp;<span class="swatch swatch-i"
      ></span>Infectious &nbsp;&nbsp;<span class="swatch swatch-r"></span>Recovered
    </p>

    <p id="tick-status" aria-live="polite"></p>
    <p id="outcome-readout" class="outcome" aria-live="polite"></p>
  </section>

  <section class="explainer">
    <h2>Why there's a threshold at all</h2>
    <p>
      Every infected particle recovers after a fixed number of frames, so
      whether the disease grows or dies out depends entirely on whether each
      infected person manages to brush past — and pass it on to — more or
      less than one other susceptible person, on average, before they
      recover. That's what the contact-rate slider controls. Below the
      threshold, each chain of infection is shorter than the last and the
      outbreak sputters out after a handful of cases — exactly what would
      happen if you tried to start a chain letter that each person only
      forwarded to less than one friend. Above it, each case produces more
      than one new case, and that compounding is explosive. Textbook
      epidemiology calls that dividing line <strong>R₀ = 1</strong>, and it's
      the whole reason public health measures target contact rate rather
      than trying to treat every case after the fact. Watching that flip
      play out on a field of bouncing dots, rather than a formula, is a
      framing popularised by 3Blue1Brown's <a
        href="https://www.youtube.com/watch?v=gxAaO2rsdIs"
        target="_blank"
        rel="noopener">"Simulating an Epidemic"</a
      > (2020) — the sections further down borrow its structure for a few
      more ideas, on this same particle engine.
    </p>
  </section>

  <section class="panel" aria-label="What each parameter really does">
    <h2>What each control actually does, in the real world</h2>
    <p>
      Click a parameter to see what the epidemiological literature says about
      it — separate from what happens in this toy simulation.
    </p>
    <div class="btn-row" role="group" aria-label="Parameters">
      <button
        class="btn"
        type="button"
        data-toggle="param-detail-contact"
        data-toggle-group="params"
        aria-expanded="false">Contact rate</button
      >
      <button
        class="btn"
        type="button"
        data-toggle="param-detail-density"
        data-toggle-group="params"
        aria-expanded="false">Population density</button
      >
      <button
        class="btn"
        type="button"
        data-toggle="param-detail-incubation"
        data-toggle-group="params"
        aria-expanded="false">Incubation period</button
      >
      <button
        class="btn"
        type="button"
        data-toggle="param-detail-isolation"
        data-toggle-group="params"
        aria-expanded="false">Isolation / quarantine</button
      >
    </div>

    <div class="param-detail" id="param-detail-contact" hidden>
      <p>
        R₀ isn't a fixed property of a pathogen on its own — it's contact
        rate multiplied by biology. The same virus can have a very different
        R₀ in a crowded venue versus a spread-out one, because how often
        people actually meet does most of the work in that number. That's
        exactly what the slider above is standing in for.
        <a
          href="https://wwwnc.cdc.gov/eid/article/25/1/17-1901_article"
          target="_blank"
          rel="noopener">CDC, Emerging Infectious Diseases, "Complexity of the Basic Reproduction Number (R0)" (2019)</a
        >.
      </p>
    </div>
    <div class="param-detail" id="param-detail-density" hidden>
      <p>
        Density is one of the biggest real-world levers on contact rate
        itself: packing the same number of people into a smaller space means
        each person brushes past more others per hour, with nobody's
        behaviour changing at all. The density slider above changes exactly
        that about the particles, while contact rate stays fixed.
        <a
          href="https://wwwnc.cdc.gov/eid/article/25/1/17-1901_article"
          target="_blank"
          rel="noopener">CDC, Emerging Infectious Diseases, "Complexity of the Basic Reproduction Number (R0)" (2019)</a
        >.
      </p>
    </div>
    <div class="param-detail" id="param-detail-incubation" hidden>
      <p>
        A longer incubation period gives a case more days to move around and
        meet people before anyone knows to look for it. Contact tracing needs
        a window at least as long as the incubation period to catch contacts
        in time — one analysis modelled roughly 2 days of tracing needed for
        flu, 4 days for COVID-19, and 10 days for measles, tracking each
        disease's own typical incubation length.
        <a href="https://arxiv.org/pdf/2005.12045" target="_blank" rel="noopener"
          >Ahmed et al., "Demystifying the Efficacy of WiFi Tracing," arXiv:2005.12045</a
        >. COVID-19's own incubation period is separately modelled as
        lognormal with a mean around 5.5 days —
        <a
          href="https://www.science.org/doi/10.1126/science.abb6936"
          target="_blank"
          rel="noopener">Kucharski et al., Science (2020)</a
        >.
      </p>
    </div>
    <div class="param-detail" id="param-detail-isolation" hidden>
      <p>
        Isolating a case only removes them from circulation once they're
        confirmed — it does nothing about anyone still incubating, which is
        exactly how the quarantine checkbox above behaves: it freezes
        infectious particles, not exposed ones. Modelling suggests contact
        tracing needs to be paired with testing rather than relied on alone,
        with the two combined needing on the order of 60% efficacy to push R
        below 1.
        <a href="https://publichealth.jmir.org/2021/10/e32468/" target="_blank" rel="noopener"
          >JMIR Public Health Surveillance 2021;7(10):e32468</a
        >.
      </p>
    </div>
  </section>

  <section class="panel" aria-label="Where real diseases sit on this line">
    <h2>Where real diseases sit on this line</h2>
    <p>
      These are commonly cited estimates for a specific outbreak, not fixed
      properties of a pathogen (see "contact rate" above) — read each as one
      well-sourced data point, not a universal constant. Clicking a marker
      also sets the simulation above to that value.
    </p>

    <div class="r0-track" role="group" aria-label="Real diseases by R0">
      <div class="r0-track-line"></div>
      <button
        class="r0-marker"
        type="button"
        style="left: 23%"
        data-rate="1.3"
        data-toggle="disease-detail-flu"
        data-toggle-group="diseases"
        aria-expanded="false"
      >
        <span class="r0-marker-dot"></span>
        <span class="r0-marker-label">Flu<br />≈1.3</span>
      </button>
      <button
        class="r0-marker"
        type="button"
        style="left: 43%"
        data-rate="2"
        data-toggle="disease-detail-covid"
        data-toggle-group="diseases"
        aria-expanded="false"
      >
        <span class="r0-marker-dot"></span>
        <span class="r0-marker-label">COVID-19<br />≈2</span>
      </button>
      <button
        class="r0-marker"
        type="button"
        style="left: 49%"
        data-rate="2.2"
        data-toggle="disease-detail-ebola"
        data-toggle-group="diseases"
        aria-expanded="false"
      >
        <span class="r0-marker-dot"></span>
        <span class="r0-marker-label">Ebola<br />≈2.2</span>
      </button>
      <button
        class="r0-marker r0-marker-offchart"
        type="button"
        data-toggle="disease-detail-measles"
        data-toggle-group="diseases"
        aria-expanded="false">Measles sits far off this scale, at R₀ 12–18 →</button
      >
    </div>

    <p class="preset-caption">Or pick a regime:</p>
    <div class="btn-row">
      <button
        class="btn"
        type="button"
        data-rate="0.6"
        data-toggle="disease-detail-below"
        data-toggle-group="diseases"
        aria-expanded="false">R₀ &lt; 1</button
      >
      <button
        class="btn"
        type="button"
        data-rate="1.0"
        data-toggle="disease-detail-at"
        data-toggle-group="diseases"
        aria-expanded="false">R₀ ≈ 1</button
      >
      <button
        class="btn"
        type="button"
        data-rate="3.0"
        data-toggle="disease-detail-above"
        data-toggle-group="diseases"
        aria-expanded="false">R₀ &gt; 1</button
      >
    </div>

    <p class="disease-detail-placeholder" id="diseases-placeholder">
      Click a disease marker or a regime button above.
    </p>
    <div class="disease-detail" id="disease-detail-flu" hidden>
      <p>
        <strong>Seasonal influenza, most years — R₀ ≈1.3.</strong> Just above
        the threshold, which is exactly why flu manages to circulate every
        winter without either vanishing or exploding: a systematic review of
        published estimates puts most flu seasons in the 1.2–1.4 range.
        <a
          href="https://stacks.cdc.gov/view/cdc/25291/cdc_25291_DS1.pdf"
          target="_blank"
          rel="noopener">Biggerstaff et al., "Estimates of the reproduction number for seasonal, pandemic, and zoonotic influenza," BMC Infectious Diseases (2014)</a
        >.
      </p>
    </div>
    <div class="disease-detail" id="disease-detail-covid" hidden>
      <p>
        <strong>COVID-19, original strain — Wuhan, late 2019 into early
          2020, R₀ ≈2.</strong> Early estimates before any vaccination or
        widespread immunity put R0 in the range 1.4–3.9, with a pooled
        estimate around 2.66 — comfortably clear of the threshold, which is
        why it became a global pandemic within months of first being
        detected.
        <a
          href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9517346/"
          target="_blank"
          rel="noopener">Systematic review and meta-analysis, PMC9517346</a
        >.
      </p>
    </div>
    <div class="disease-detail" id="disease-detail-ebola" hidden>
      <p>
        <strong>Ebola virus disease, West Africa — 2014–2016, R₀
          ≈1.5–2.5.</strong> A similar range to COVID-19's, despite requiring
        direct contact with bodily fluids rather than airborne spread —
        funeral rites and unprotected caregiving during that outbreak pushed
        contact rate up enough to compensate for a harder-to-transmit virus.
        <a
          href="https://transportgeography.org/contents/applications/transportation-pandemics/basic-reproduction-number-r0-of-major-infectious-diseases/"
          target="_blank"
          rel="noopener">The Geography of Transport Systems, "Basic Reproduction Number (R0) of Major Infectious Diseases"</a
        >.
      </p>
    </div>
    <div class="disease-detail" id="disease-detail-measles" hidden>
      <p>
        <strong>Measles, pre-vaccination era — R₀ 12–18,</strong> off this
        track entirely. Estimates from the pre-vaccine United States
        (1912–1928) and England and Wales (1944–1979) put it there: one of
        the most contagious diseases known, and part of why measles needs
        such a high vaccination rate to stay controlled (see "R₀ ≈ 1"
        below).
        <a
          href="https://stacks.cdc.gov/view/cdc/80426/cdc_80426_DS1.pdf"
          target="_blank"
          rel="noopener">CDC</a
        >.
      </p>
    </div>
    <div class="disease-detail" id="disease-detail-below" hidden>
      <p>
        <strong>R₀ &lt; 1 — outbreaks brought under control.</strong> SARS's
        original R0 in 2003 is estimated around 3, but intensive contact
        tracing and patient isolation drove the effective reproduction
        number below 1 within weeks in most affected cities, which is why
        SARS was contained rather than becoming a pandemic —
        <a
          href="https://wwwnc.cdc.gov/eid/article/10/7/03-0647_article"
          target="_blank"
          rel="noopener">CDC, Emerging Infectious Diseases (2004)</a
        >. Seventeen years later, the same lever — reduced contact rate, this
        time through lockdowns rather than case isolation — pushed COVID-19's
        effective R below 1 across most of Europe within the first weeks of
        2020's restrictions.
        <a
          href="https://www.nature.com/articles/s41586-020-2405-7"
          target="_blank"
          rel="noopener">Flaxman et al., Nature (2020)</a
        >.
      </p>
    </div>
    <div class="disease-detail" id="disease-detail-at" hidden>
      <p>
        <strong>R₀ ≈ 1 — the threshold itself.</strong> This is the exact
        dividing line the simulation above is built around: every infectious
        person replacing themselves with, on average, one new case. It's
        also the basis of the herd-immunity threshold, calculated as
        1 − 1/R0 — the share of a population that needs to be immune before a
        pathogen can no longer sustain itself, even without any other
        interventions. A disease with R0 = 2 needs roughly 50% immunity;
        measles, at R0 12–18, needs upwards of 92%.
        <a
          href="https://royalsociety.org/-/media/policy/projects/set-c/set-c-herd-immunity.pdf"
          target="_blank"
          rel="noopener">Royal Society SET-C report (November 2020)</a
        >.
      </p>
    </div>
    <div class="disease-detail" id="disease-detail-above" hidden>
      <p>
        <strong>R₀ &gt; 1 — the compounding zone.</strong> Every disease on
        this track sits here by default until something — behaviour,
        immunity, intervention — pushes it back down. The higher above 1,
        the fewer generations of infection it takes to reach a large share
        of the population, which is the entire difference between the
        seasonal-flu slog and COVID-19's original wave arriving within
        months of first being detected.
      </p>
    </div>
  </section>

  <section class="explainer">
    <h2>One shared errand can undo the rest of your precautions</h2>
    <p>
      3Blue1Brown's video runs a version of this experiment: even after
      everyone else's day-to-day movement is turned right down, routing each
      person through one shared destination now and then — his example is a
      grocery store — brings the outbreak roaring back, because that one
      stop manufactures far more contacts per visit than the same amount of
      free wandering ever would. Switch the layout above to
      <strong>Central location</strong> and try a contact rate that fizzled
      out under Simple: the shared hotspot alone, with nothing else changed,
      is often enough to tip an otherwise-controlled number back over the
      threshold. It's the same reason public health advice singles out
      crowded indoor gatherings specifically — it's not the total number of
      contacts across a day that matters most, it's whether a large share of
      them happen in one dense burst.
    </p>
  </section>

  <section class="explainer">
    <h2>Splitting into groups helps, even with rare travel between them</h2>
    <p>
      The same video also runs the opposite structural experiment: several
      separate communities, linked only by occasional travel, with
      quarantine measures layered on once a travelling case is spotted. An
      outbreak that would tear through one big mixed population can stay
      mostly contained within a single community if the links between
      communities are rare enough — travel has to happen for the disease to
      reach a new group at all, so cutting how often it happens caps how
      many groups ever get seeded, even at an unchanged R0 within each
      group. Switch the layout above to <strong>Communities</strong> and
      compare the outcome at the same contact rate that swept through
      Simple: with only a small chance per particle of jumping to a
      different quadrant each frame, several communities can burn out on
      their own before the jump ever reaches them.
    </p>
    <p>
      Worth repeating the video's own caveat here too: it's an illustrative
      agent-based model built for a general audience, not the epidemiological
      modelling used to plan an actual response — the shapes of the curves
      are the takeaway, not their exact numbers. The R0 values on the track
      above come from the published literature instead, for that reason.
    </p>
  </section>
</BaseLayout>

<script>
  import { initEpidemicThreshold } from "../scripts/epidemic-threshold";
  initEpidemicThreshold();
</script>

<style>
  .preset-caption {
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .preset-note {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 0;
  }

  .assumption {
    margin-top: var(--space-4);
  }

  .quarantine-row {
    margin-top: var(--space-3);
    color: var(--fg);
  }

  .sim-controls {
    margin-bottom: var(--space-3);
  }

  [data-mode] {
    opacity: 0.6;
  }

  [data-mode][aria-pressed="true"] {
    opacity: 1;
    font-weight: 600;
  }

  .sim-canvas {
    width: 100%;
    max-width: 40rem;
    aspect-ratio: 8 / 5;
    display: block;
    margin-inline: auto;
    background: #fafafa;
    border-radius: 0.5rem;
  }

  .network-legend {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: var(--space-2);
  }

  .swatch-s {
    background: #9ca3af;
  }

  .swatch-e {
    background: #f59e0b;
  }

  .swatch-i {
    background: #dc2626;
  }

  .swatch-r {
    background: #2563eb;
  }

  .growth-chart .area-s {
    fill: #9ca3af;
  }

  .growth-chart .area-e {
    fill: #f59e0b;
  }

  .growth-chart .area-i {
    fill: #dc2626;
  }

  .growth-chart .area-r {
    fill: #2563eb;
  }

  #tick-status {
    text-align: center;
    color: var(--muted);
  }

  .outcome {
    font-weight: 600;
    text-align: center;
    min-height: 1.6rem;
  }

  .param-detail,
  .disease-detail {
    margin-top: var(--space-3);
    padding: var(--space-3);
    background: var(--surface);
    border-radius: var(--radius);
    color: var(--fg);
  }

  .disease-detail-placeholder {
    color: var(--muted);
    font-style: italic;
  }

  [data-toggle] {
    opacity: 0.85;
  }

  [data-toggle][aria-expanded="true"] {
    opacity: 1;
    font-weight: 600;
  }

  .r0-track {
    position: relative;
    height: 6rem;
    margin: var(--space-4) 0 var(--space-2);
  }

  .r0-track-line {
    position: absolute;
    top: 1.4rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--border);
  }

  .r0-marker {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.75rem;
    color: var(--fg);
    padding: 0;
  }

  .r0-marker-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 1.1rem;
  }

  .r0-marker-label {
    text-align: center;
    line-height: 1.2;
  }

  .r0-marker:nth-of-type(2n) .r0-marker-label {
    margin-top: 1.5rem;
  }

  .r0-marker-offchart {
    position: static;
    transform: none;
    display: block;
