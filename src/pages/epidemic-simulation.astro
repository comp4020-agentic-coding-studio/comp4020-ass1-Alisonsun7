---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Epidemic simulation — bonus recreation"
  description="An original, from-scratch recreation of the bouncing-dot epidemic simulation genre, built as an extra alongside the graded Epidemic threshold page."
  accent="violet"
  activePath={`${base}epidemic-simulation/`}
>
  <h1>Bouncing-dot epidemic simulation</h1>
  <p class="lede">
    This is a bonus page, not the graded submission — see <a href={`${base}epidemic-threshold/`}>Epidemic
    threshold</a> for that. It's
    an original, from-scratch build of the well-known "particles bounce around
    and infect each other" style of epidemic visualisation that shows up in
    explainer videos and web toys. Every line of code and text on this page
    was written for this assignment.
  </p>

  <section class="panel sim-recreation" aria-label="Particle simulation">
    <div class="btn-row" role="tablist" aria-label="Simulation layout">
      <button class="btn" type="button" data-rec-mode="simple" aria-pressed="true">Simple</button>
      <button class="btn" type="button" data-rec-mode="central" aria-pressed="false">Central location</button>
      <button class="btn" type="button" data-rec-mode="communities" aria-pressed="false">Communities</button>
    </div>

    <div class="rec-canvas-wrap">
      <canvas id="rec-canvas" width="640" height="420" aria-label="Particle simulation canvas"></canvas>
    </div>

    <p class="chart-legend">
      <span class="swatch" style="background: #c8ccd6"></span>Susceptible
      <span class="swatch" style="background: #e0455f"></span>Infected
      <span class="swatch" style="background: #4d8dff"></span>Recovered
    </p>

    <div class="controls">
      <div class="control">
        <label for="rec-density">Population density <output id="rec-density-output">5</output></label>
        <input type="range" id="rec-density" min="1" max="10" step="1" value="5" />
      </div>
      <div class="control">
        <label for="rec-contact">Contact rate <output id="rec-contact-output">1.5</output></label>
        <input type="range" id="rec-contact" min="0.5" max="4" step="0.1" value="1.5" />
      </div>
      <label class="rec-checkbox" for="rec-quarantine">
        <input type="checkbox" id="rec-quarantine" />
        Quarantine
      </label>
    </div>

    <div class="btn-row">
      <button class="btn" type="button" id="rec-pause">Pause</button>
      <button class="btn" type="button" id="rec-reset">Reset</button>
    </div>

    <div class="stat-row">
      <div class="stat"><span class="value" id="rec-day">0</span><span class="label">Day</span></div>
      <div class="stat"><span class="value" id="rec-s">149</span><span class="label">Susceptible</span></div>
      <div class="stat"><span class="value" id="rec-i">1</span><span class="label">Infected</span></div>
      <div class="stat"><span class="value" id="rec-r">0</span><span class="label">Recovered</span></div>
    </div>

    <svg class="growth-chart" id="rec-chart" viewBox="0 0 300 120" preserveAspectRatio="none">
      <polygon id="rec-band-s" points="0,0 300,0 300,0 0,0"></polygon>
      <polygon id="rec-band-i" points="0,120 300,120 300,120 0,120"></polygon>
      <polygon id="rec-band-r" points="0,120 300,120 300,120 0,120"></polygon>
    </svg>
  </section>

  <p class="explainer">
    Design and interactions here are inspired by the wider genre of
    bouncing-dot epidemic visualisations — including 3Blue1Brown's <em>"Simulating
    an Epidemic"</em> video and various independent web demos
    that popularised it — not copied from any single one of them. The engine
    (particle movement, infection checks, the three layouts, quarantine) and
    all of the wording above are original code and text written for this
    assignment.
  </p>

  <script>
    import { initEpidemicSimulation } from "../scripts/epidemic-simulation";
    initEpidemicSimulation();
  </script>

  <style>
    .sim-recreation {
      --bg: #06070c;
      --surface: #12141d;
      --fg: #f5f5f7;
      --muted: #9aa0ac;
      --border: #2a2d3a;
      --accent: #7c9dff;
      --accent-fg: #06070c;
      background: var(--bg);
      color: var(--fg);
    }

    .rec-canvas-wrap {
      display: flex;
      justify-content: center;
      margin-block: var(--space-3);
    }

    #rec-canvas {
      width: 100%;
      max-width: 40rem;
      height: auto;
      background: #000;
      border-radius: var(--radius);
    }

    .rec-checkbox {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-weight: 600;
      cursor: pointer;
    }

    #rec-band-s {
      fill: #c8ccd6;
    }

    #rec-band-i {
      fill: #e0455f;
    }

    #rec-band-r {
      fill: #4d8dff;
    }
  </style>
</BaseLayout>
